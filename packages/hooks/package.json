{
  "name": "@allem-sdk/hooks",
  "version": "0.1.1",
  "description": "A collection of essential React hooks for modern applications",
  "license": "MIT",
  "author": "Ahmed Allem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-sdk.git",
    "directory": "packages/hooks"
  },
  "keywords": ["allem-sdk", "react", "hooks", "useDebounce", "useMediaQuery", "useLocalStorage"],
  "publishConfig": {
    "access": "public"
  }
}
