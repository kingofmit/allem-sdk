{
  "name": "@allem-sdk/storage",
  "version": "0.1.0",
  "description": "Provider-agnostic key-value storage for React. Adapters for localStorage, sessionStorage, cookies, and in-memory. useStorage, useStorageItem. SSR-safe.",
  "license": "MIT",
  "author": "Ahmed Allem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-sdk.git",
    "directory": "packages/storage"
  },
  "keywords": [
    "allem-sdk",
    "react",
    "react-hooks",
    "storage",
    "localStorage",
    "sessionStorage",
    "cookies",
    "key-value",
    "ssr",
    "typescript",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
