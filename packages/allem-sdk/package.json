{
  "name": "allem-sdk",
  "version": "0.1.4",
  "description": "The React SDK for AI agents, chat, forms, auth, analytics, and 8 essential hooks. One install, zero lock-in. Built on Vercel AI SDK v6.",
  "license": "MIT",
  "author": "Ahmed Allem (https://kingallem.com)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.mjs",
      "require": "./dist/forms.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.mjs",
      "require": "./dist/analytics.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.mjs",
      "require": "./dist/auth.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.mjs",
      "require": "./dist/agents.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "import": "./dist/notifications.mjs",
      "require": "./dist/notifications.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.mjs",
      "require": "./dist/realtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@allem-sdk/hooks": "workspace:*",
    "@allem-sdk/ai": "workspace:*",
    "@allem-sdk/forms": "workspace:*",
    "@allem-sdk/analytics": "workspace:*",
    "@allem-sdk/auth": "workspace:*",
    "@allem-sdk/agents": "workspace:*",
    "@allem-sdk/storage": "workspace:*",
    "@allem-sdk/notifications": "workspace:*",
    "@allem-sdk/realtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-sdk.git",
    "directory": "packages/allem-sdk"
  },
  "keywords": [
    "allem-sdk",
    "react",
    "react-hooks",
    "ai",
    "ai-agents",
    "ai-sdk",
    "vercel-ai-sdk",
    "chatbot",
    "tool-calling",
    "forms",
    "validation",
    "analytics",
    "auth",
    "authentication",
    "sdk",
    "typescript",
    "nextjs",
    "ssr",
    "hooks"
  ],
  "publishConfig": {
    "access": "public"
  }
}
